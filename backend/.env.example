# Smart Agro AI backend configuration example.
# Copy this file to .env for local development if your process loader supports it.
# Never commit real .env files, API keys, database files, password hashes, or user data.

# Comma-separated frontend origins allowed to call the API.
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to a local SQLite database at backend/smartagro_local.db.
# For SQLite, use a URL such as: sqlite:///D:/path/to/smartagro_local.db
DATABASE_URL=

# Optional comma-separated list for local demo admin registration.
# Leave empty for public/open-source use.
ADMIN_EMAILS=

# Required for production. The app uses a development-only fallback if omitted.
# Use a long, random value in deployed environments and never commit it.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Reserved for future real AI integrations. Do not commit real keys.
GEMINI_API_KEY=
